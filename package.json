  "homepage": "https://github.com/step-security/repository-dispatch#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "axios": "^1.13.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^18.19.130",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^8.57.1",
    "eslint-plugin-github": "^4.10.2",
    "eslint-plugin-jest": "^25.7.0",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.4.2",
    "jest-circus": "^30.4.1",
    "js-yaml": "^4.1.1",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
