{
  "name": "repository-dispatch",
  "version": "4.0.0",
  "private": true,
  "description": "Create a repository dispatch event",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.4.0"
  },
  "scripts": {
    "build": "tsc && ncc build lib/main.js -o dist",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "test": "jest --passWithNoTests"
  },
  "repository": {
    "type": "git",
